    "/uploads/images": {
      "post": {
        "operationId": "uploadImage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image file (JPEG, PNG, WebP, AVIF, HEIF, GIF - max 8MB)"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image processed and converted to WebP successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "example": "/uploads/abcd-1234.webp"
                    },
                    "thumbnailUrl": {
                      "type": "string",
                      "example": "/uploads/abcd-1234-thumb.webp"
                    },
                    "width": {
                      "type": "number",
                      "example": 1200
                    },
                    "height": {
                      "type": "number",
                      "example": 800
                    },
                    "format": {
                      "type": "string",
                      "example": "webp"
                    },
                    "size": {
                      "type": "number",
                      "example": 124500
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid image or unsupported format"
          },
          "401": {
            "description": "Unauthorized"
          },
          "413": {
            "description": "File size exceeds limit"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload and process image to WebP with responsive variants",
        "tags": [
